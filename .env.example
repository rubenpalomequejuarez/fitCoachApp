# Copia este archivo a .env y ajusta los valores. El archivo .env no se sube al repositorio.

# PostgreSQL de desarrollo (docker compose)
POSTGRES_USER=fitcoach
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=fitcoach
POSTGRES_PORT=5432

# Cadena de conexión para la API (todavía no se usa: la API guarda los datos en JSON)
DATABASE_URL=postgresql://fitcoach:cambia-esta-clave@localhost:5432/fitcoach
