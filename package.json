{
  "name": "fitcoach",
  "version": "1.0.0",
  "private": true,
  "description": "FitCoach: app para entrenadores personales y sus clientes",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fitcoach/web",
    "dev:api": "npm run dev -w @fitcoach/api",
    "build": "npm run build -w @fitcoach/web",
    "start": "npm start -w @fitcoach/api",
    "test": "npm test --workspaces --if-present",
    "seed": "npm run seed -w @fitcoach/api",
    "reset-data": "npm run reset-data -w @fitcoach/api"
  },
  "engines": {
    "node": ">=22"
  }
}
