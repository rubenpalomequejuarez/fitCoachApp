{
  "name": "fitcoach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FitCoach: app para entrenadores personales y sus clientes",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,yellow \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "seed": "node server/run-seed.js",
    "reset-data": "node server/reset.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=18"
  }
}
